# Copy to docker-compose.env on EC2 (never commit real secrets).
POSTGRES_USER=riseup
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=riseup
PUBLIC_APP_URL=https://kinetix.mindrind.com

# REQUIRED in staging/production. docker-compose.yml falls back to a
# hardcoded dev secret (committed in git) if these are unset, which lets
# anyone with repo access forge valid tokens for any user. Set both to a
# unique random value per environment before going live:
#   openssl rand -hex 32
# Changing these logs out every currently signed-in user (old tokens no
# longer verify), so only rotate deliberately.
JWT_ACCESS_SECRET=change-me-staging-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-staging-refresh-secret-min-32-chars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# File attachments (S3) — required for uploads; copy from production backend-py/.env
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ATTACHMENTS_BUCKET=

# AI Assistant Provider Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
