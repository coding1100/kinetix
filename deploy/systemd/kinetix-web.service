[Unit]
Description=Kinetix Web (Next.js)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/clickup/kinetix/frontend/.next/standalone
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# next.config.ts sets output: standalone - "next start" does not work with that
# (Next.js warns and serves static chunks incorrectly). Run the standalone
# server.js instead, same as frontend/Dockerfile does for the Docker path.
# Do NOT use ExecStartPre with pkill -f "next dev" — the shell cmdline contains
# that string and pkill kills itself, causing "fatal signal to control process".
ExecStart=/usr/bin/env node /opt/clickup/kinetix/frontend/.next/standalone/server.js
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
