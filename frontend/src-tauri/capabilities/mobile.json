{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Default permissions capability for Kinetix mobile app",
  "windows": ["main"],
  "platforms": ["android", "iOS"],
  "remote": {
    "urls": ["https://kinetix.mindrind.com/*"]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "notification:allow-notify",
    "shell:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "href": "http://*" },
        { "href": "https://*" },
        { "href": "mailto:*" }
      ]
    }
  ]
}
