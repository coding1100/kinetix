# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tauri
src-tauri/target/

# tauri android (Gradle/Kotlin build outputs and local caches - the gen/android
# project source itself is committed, these generated artifacts are not)
src-tauri/gen/android/.gradle/
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
src-tauri/gen/android/app/src/main/jniLibs/
src-tauri/gen/android/buildSrc/build/
src-tauri/gen/android/buildSrc/.gradle/
src-tauri/gen/android/local.properties
